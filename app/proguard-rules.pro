# Keep JS bridge + service classes (referenced by name from WebView assets).
-keep class com.dsh.mobile.ui.DshJsBridge { *; }
-keep class com.dsh.mobile.service.AgentRuntimeService { *; }

# Every @JavascriptInterface method is invoked by name from JavaScript; R8
# cannot see those call sites and would otherwise strip/rename them.
-keepclassmembers class com.dsh.mobile.ui.** {
    @android.webkit.JavascriptInterface <methods>;
}

# Enums in RuntimeConfigStore are persisted by name in DataStore.
-keepclassmembers enum com.dsh.mobile.data.** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# -- dontwarn: compile-only annotation dependencies ------------------------
# Tink (pulled in by androidx.security-crypto for the Keystore-backed API key
# vault) references Error Prone/JSR-305 annotations that are compile-time only
# and never present at runtime. Rules generated by AGP at
# build/outputs/mapping/release/missing_rules.txt.
-dontwarn com.google.errorprone.annotations.CanIgnoreReturnValue
-dontwarn com.google.errorprone.annotations.CheckReturnValue
-dontwarn com.google.errorprone.annotations.Immutable
-dontwarn com.google.errorprone.annotations.RestrictedApi
-dontwarn javax.annotation.Nullable
-dontwarn javax.annotation.concurrent.GuardedBy